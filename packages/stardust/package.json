{
  "name": "@dreambase/stardust",
  "version": "0.1.0",
  "description": "Stardust \u2014 an Apple HIG-faithful, fully themeable design system for the web. macOS, iPadOS and iOS in one framework, built on ui-sdk.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./themes/*.css": "./src/styles/themes/*.css",
    "./theme": "./src/lib/theme.ts",
    "./derive": "./src/lib/derive.ts",
    "./*": "./src/components/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/react": "0.1.0-beta.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19",
    "jsdom": "^26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5",
    "vitest": "^3"
  }
}
